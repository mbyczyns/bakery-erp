generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BakeryProductType {
  BREAD
  ROLL
  SWEET
  SAVORY
}

enum UserRole {
  ADMIN
  BAKER
  MANAGER
}

enum ContractorType {
  SUPPLIER
  CUSTOMER
  OTHER
}

enum InvoiceType {
  VAT
  RECEIPT
  CORRECTION
  MANUAL
}

enum InvoiceStatus {
  IMPORTED
  WAITING
  REJECTED
}

enum IngredientType {
  FLOUR
  OTHER
}

model User {
  id        String   @id @default(uuid())
  name      String?
  login     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
}

model Contractor {
  id            String         @id @default(uuid())
  type          ContractorType @default(SUPPLIER)
  name          String
  nip           String         @unique
  address       String
  email         String
  phone         String
  contactPerson String?
  notes         String?
  createdAt     DateTime       @default(now())

  products Product[]
  invoices Invoice[]
}

model Invoice {
  id            String        @id @default(uuid())
  contractorId  String
  contractor    Contractor    @relation(fields: [contractorId], references: [id])
  type          InvoiceType   @default(VAT)
  ksefNumber    String        @unique
  invoiceNumber String
  issuedDate    DateTime      @db.Date
  dueDate       DateTime      @db.Date
  status        InvoiceStatus @default(WAITING)
  grossAmount   Decimal       @default(0.00)
  netAmount     Decimal       @default(0.00)
  vatAmount     Decimal       @default(0.00)
  currency      String        @default("PLN")
  importDate    DateTime      @default(now())

  positions InvoicePosition[]
}

model InvoicePosition {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  name     String
  quantity Decimal @default(1.00)
  unit     String  @default("szt")

  netPrice    Decimal @default(0.00)
  netAmount   Decimal @default(0.00)
  vatRate     Decimal @default(23.00)
  grossAmount Decimal @default(0.00)

  createdAt DateTime @default(now())
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id    String  @id @default(uuid())
  name  String
  price Decimal @default(0.00)
  unit  String

  supplier   Contractor @relation(fields: [supplierId], references: [id])
  supplierId String

  category   ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  sellingPrice Decimal? @default(0.00)
  isResale     Boolean  @default(false)

  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  ingredientId String?

  invoicePositions InvoicePosition[]
  createdAt        DateTime          @default(now())

  @@unique([supplierId, name])
}

model Ingredient {
  id              String  @id @default(uuid())
  name            String  @unique
  unit            String
  calculatedPrice Decimal @default(0.00)

  type IngredientType @default(OTHER)

  products                Product[]
  recipeIngredients       RecipeIngredient[]
  semiFinishedIngredients SemiFinishedIngredient[]

  createdAt DateTime @default(now())
}

model SemiFinished {
  id            String                   @id @default(uuid())
  name          String
  cost          Decimal                  @default(0.00)
  unit          String
  ingredients   SemiFinishedIngredient[]
  bakeryRecipes RecipeIngredient[]
  createdAt     DateTime                 @default(now())
}

model SemiFinishedIngredient {
  id     String  @id @default(uuid())
  amount Decimal
  unit   String

  semiFinishedId String
  semiFinished   SemiFinished @relation(fields: [semiFinishedId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model BakeryProduct {
  id             String             @id @default(uuid())
  name           String
  type           BakeryProductType  @default(BREAD)
  productionCost Decimal            @default(0.00)
  sellingPrice   Decimal            @default(0.00)
  ingredients    RecipeIngredient[]
  productions    DailyProduction[]
  createdAt      DateTime           @default(now())
}

model RecipeIngredient {
  id             String  @id @default(uuid())
  amount         Decimal
  ingredientUnit String

  bakeryProductId String
  bakeryProduct   BakeryProduct @relation(fields: [bakeryProductId], references: [id], onDelete: Cascade)

  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  semiFinishedId String?
  semiFinished   SemiFinished? @relation(fields: [semiFinishedId], references: [id], onDelete: Cascade)
}

model DailyProduction {
  id              String        @id @default(uuid())
  date            DateTime      @db.Date
  producedAmount  Int           @default(0)
  soldAmount      Int           @default(0)
  bakeryProductId String
  bakeryProduct   BakeryProduct @relation(fields: [bakeryProductId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([date, bakeryProductId])
}

model DailyIncome {
  id           String   @id @default(uuid())
  date         DateTime @db.Date
  incomeAmount Decimal  @default(0.00)
  createdAt    DateTime @default(now())
}

model CostType {
  id           String        @id @default(uuid())
  name         String
  monthlyCosts MonthlyCost[]
}

model MonthlyCost {
  id         String   @id @default(uuid())
  value      Decimal  @default(0.00)
  monthDate  DateTime @db.Date
  costTypeId String
  costType   CostType @relation(fields: [costTypeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([monthDate, costTypeId])
}
